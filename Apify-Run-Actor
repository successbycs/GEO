// Inputs to map: start_url (required), request_id (from earlier), optional: depth, max_pages
const start = (inputData.start_url || '').trim();
if (!start) throw new Error('Missing start_url');

const u = new URL(start);
const origin = u.origin;

// --- INCLUDE / EXCLUDE ---
// Add vendor-specific paths as needed (e.g., /products/*, /workflows/*)
const include = [
  `${origin}/solutions/*`, `${origin}/industries/*`,
  `${origin}/product*`, `${origin}/products/*`, `${origin}/platform*`,
  `${origin}/pricing*`, `${origin}/partners/*`,
  `${origin}/customers/*`, `${origin}/case-studies/*`, `${origin}/customer-stories/*`,
  `${origin}/compare/*`, `${origin}/alternatives/*`,
  `${origin}/security*`, `${origin}/integrations*`,
  `${origin}/use-cases/*`, `${origin}/resources/*`,
  `${origin}/workflows/*`, `${origin}/store/*`
];

const exclude = [
  `*?*`, `*#*`,
  `${origin}/careers*`, `${origin}/jobs*`,
  `${origin}/legal*`, `${origin}/privacy*`, `${origin}/terms*`,
  `${origin}/help*`, `${origin}/support*`,
  `${origin}/press*`, `${origin}/brand*`,
  `${origin}/events*`, `${origin}/status*`
];

// --- OVERRIDES PAYLOAD ---
const overrides = {
  startUrls: [{ url: `${origin}/` }],
  includeUrlGlobs: include,
  excludeUrlGlobs: exclude,
  sameDomain: true,

  // Content extraction (so dataset has markdown/text)
  downloadTexts: true,
  readableContentExtractor: "mozilla-readability",
  waitFor: 'main, article, [role="main"], #main',
  waitForMillis: 1500,
  keepUrlFragments: false,
  blockMedia: true,

  // Crawl bounds
  maxRequestsPerCrawl: Number(inputData.max_pages || 60),
  maxCrawlingDepth: Number(inputData.depth || 2),

  // Correlation
  datasetName: `req_${inputData.request_id || 'unknown'}`,
  customData: { request_id: inputData.request_id || null, source: 'carrd' }
};

// Return BOTH an object and a JSON string
return {
  apify_overrides: overrides,                              // object (preferred)
  apify_overrides_json: JSON.stringify(overrides, null, 2) // string (fallback)
};
